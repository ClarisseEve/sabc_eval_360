# =============================================================================
# SABC Eval360 - Template Docker (copier vers .env avant docker compose up)
# =============================================================================

APP_NAME="SABC Eval360"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# MySQL (CORE) — port hôte exposé : 3307
# DataGrip : localhost:3307, user sabc_user, db sabc_core
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sabc_core
DB_USERNAME=sabc_user
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=***REMOVED***

# =============================================================================
# PostgreSQL (BUSINESS) — port hôte exposé : 5433
# DataGrip : localhost:5433, user sabc_user, db sabc_business
# =============================================================================
DB_PGSQL_CONNECTION=pgsql
DB_PGSQL_HOST=postgres
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=sabc_business
DB_PGSQL_USERNAME=sabc_user
DB_PGSQL_PASSWORD=secret

# =============================================================================
# ClickHouse (ANALYTICS) — ports hôte exposés : 8124 (HTTP), 9001 (native)
# DataGrip : localhost:8124 (HTTP), user default, db sabc_analytics
# =============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=sabc_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# =============================================================================
# Redis (interne au réseau Docker)
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# =============================================================================
# Cache, Session, Queue → Redis
# =============================================================================
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# =============================================================================
# Mail (optionnel)
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sabc.cm"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Microservices (Strangler Pattern)
# =============================================================================
EVALUATION_MICROSERVICE_ENABLED=false
EVALUATION_SERVICE_URL=http://evaluation-service:8080
EVALUATION_SERVICE_GRPC=evaluation-service:50051
SERVICE_KEY=internal-service-key-change-me
JWT_SECRET=your-jwt-secret-change-me

ANALYTICS_MICROSERVICE_ENABLED=false
ANALYTICS_SERVICE_URL=http://analytics-service:8080
ANALYTICS_SERVICE_KEY=internal-service-key-change-me

# =============================================================================
# Observabilité (Jaeger) — profile: observability
# =============================================================================
JAEGER_ENABLED=false
JAEGER_SERVICE_NAME=core-app
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
JAEGER_LOG_SPANS=false

# =============================================================================
# Grafana — profile: observability
# =============================================================================
GRAFANA_PASSWORD=admin

# =============================================================================
# Alertmanager — profile: observability
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=

# =============================================================================
# Vite (Frontend)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
