# Modèle de configuration locale : copier vers apps/api/.env et remplacer les
# CHANGE_ME. Ne pas réutiliser ces valeurs dans un environnement partagé.

# API
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# MySQL (core : utilisateurs, structure org)
DATABASE_URL=mysql://sabc_user:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/sabc_core

# PostgreSQL (business : evaluations, periodes)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sabc_business
PG_USER=sabc_user
PG_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Cache Redis
CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# Données de démonstration locale
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD
