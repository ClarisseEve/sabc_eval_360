# Modèle de configuration: copier vers apps/api/.env puis remplacer chaque
# CHANGE_ME. Aucune valeur réelle ne doit être committée, même en développement.

# API
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT — générer avec: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# MySQL (core: utilisateurs, structure org)
DATABASE_URL="mysql://sabc_user:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/sabc_core"

# PostgreSQL (business: evaluations, periodes)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sabc_business
PG_USER=sabc_user
PG_PASSWORD=CHANGE_ME_PG_PASSWORD

# Seed — mot de passe commun aux comptes de démonstration.
# Le seed refuse de démarrer si cette variable est absente.
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD
