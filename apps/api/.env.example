# API
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# MySQL (core: utilisateurs, structure org)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3307/sabc_core"

# PostgreSQL (business: evaluations, periodes)
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=sabc_business
PG_USER=DB_USER
PG_PASSWORD=DB_PASSWORD

# Analytics microservice (strangler pattern)
ANALYTICS_MICROSERVICE_ENABLED=false
ANALYTICS_SERVICE_URL=http://localhost:8082
ANALYTICS_SERVICE_KEY=CHANGE_ME
