import React, { useState, FormEvent, ChangeEvent } from 'react';
import { Head, useForm, Link } from '@inertiajs/react';
import AppLayout from '@/Components/Layout/app/AppLayout';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/Components/UI/Card/Card';
import { Button } from '@/Components/UI/Button/Button';
import { Input } from '@/Components/UI/Input/Input';
import { Label } from '@/Components/UI/Label/Label';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/Components/UI/Select';
import { Badge } from '@/Components/UI/Badge/Badge';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/Components/UI/Tabs/Tabs';
import { GripVertical, Plus, X, PlusCircle, Trash2, ArrowUp, ArrowDown } from 'lucide-react';
import { cn } from '@/lib/utils';

/**
 * Page de création de template d'évaluation pour l'administrateur
 * 
 * Spécifications selon les règles métier SABC :
 * - Templates d'évaluation par catégorie (Commercial/Marketing)
 * - Sections et compétences configurables
 * - Minimum 5 compétences par template
 */

// Interface pour les types de données
interface Competence {
  id: string;
  libelle: string;
  description: string;
  niveau_requis: number;
  ordre: number;
}

interface Section {
  id: string;
  titre: string;
  description: string;
  ordre: number;
  competences: Competence[];
}

interface TemplateFormData {
  titre: string;
  description: string;
  categorie: string;
  est_actif: boolean;
  sections: Section[];
  [key: string]: any; // Ajout d'un index signature pour satisfaire FormDataType
}

const CreateTemplateAdminPage: React.FC = () => {

  // Formulaire principal
  const { data, setData, post, processing, errors } = useForm<TemplateFormData>({
    titre: '',
    description: '',
    categorie: 'commercial', // Valeur par défaut
    est_actif: true,
    sections: [
      {
        id: '1',
        titre: 'Section 1',
        description: 'Description de la section 1',
        ordre: 1,
        competences: [],
      },
    ],
  });
  
  // État pour la compétence en cours d'ajout
  const [currentSection, setCurrentSection] = useState(0);
  const [newCompetence, setNewCompetence] = useState({
    libelle: '',
    description: '',
    niveau_requis: 3
  });
  
  // Ajouter une section
  const ajouterSection = () => {
    const newSections = [...data.sections];
    newSections.push({
      id: `${Date.now()}`,
      titre: '',
      description: '',
      ordre: newSections.length + 1,
      competences: []
    });
    setData('sections', newSections);
  };
  
  // Supprimer une section
  const supprimerSection = (index: number) => {
    if (data.sections.length <= 1) {
      return; // Garder au moins une section
    }
    
    const newSections = [...data.sections];
    newSections.splice(index, 1);
    
    // Réorganiser les ordres
    newSections.forEach((section, idx) => {
      section.ordre = idx + 1;
    });
    
    setData('sections', newSections);
    if (currentSection >= newSections.length) {
      setCurrentSection(newSections.length - 1);
    }
  };
  
  // Ajouter une compétence à la section courante
  const ajouterCompetence = () => {
    if (!newCompetence.libelle.trim()) return;
    
    const newSections = [...data.sections];
    newSections[currentSection].competences.push({
      id: `${Date.now()}`,
      libelle: newCompetence.libelle,
      description: newCompetence.description,
      niveau_requis: newCompetence.niveau_requis,
      ordre: newSections[currentSection].competences.length + 1
    });
    
    setData('sections', newSections);
    setNewCompetence({
      libelle: '',
      description: '',
      niveau_requis: 3
    });
  };
  
  // Supprimer une compétence
  const supprimerCompetence = (sectionIndex: number, competenceIndex: number) => {
    const newSections = [...data.sections];
    newSections[sectionIndex].competences.splice(competenceIndex, 1);
    
    // Réorganiser les ordres
    newSections[sectionIndex].competences.forEach((comp, idx) => {
      comp.ordre = idx + 1;
    });
    
    setData('sections', newSections);
  };
  
  // Déplacer une compétence vers le haut ou le bas dans une section
  const moveCompetence = (sectionIndex: number, competenceIndex: number, direction: 'up' | 'down') => {
    const newSections = [...data.sections];
    const section = newSections[sectionIndex];
    const competences = [...section.competences];
    
    if (direction === 'up' && competenceIndex > 0) {
      // Échanger avec l'élément précédent
      [competences[competenceIndex], competences[competenceIndex - 1]] = 
      [competences[competenceIndex - 1], competences[competenceIndex]];
      
      // Mettre à jour les ordres
      competences.forEach((comp, idx) => {
        comp.ordre = idx + 1;
      });
    } else if (direction === 'down' && competenceIndex < competences.length - 1) {
      // Échanger avec l'élément suivant
      [competences[competenceIndex], competences[competenceIndex + 1]] = 
      [competences[competenceIndex + 1], competences[competenceIndex]];
      
      // Mettre à jour les ordres
      competences.forEach((comp, idx) => {
        comp.ordre = idx + 1;
      });
    }
    
    section.competences = competences;
    setData('sections', newSections);
  };
  
  // Déplacer une compétence vers une autre section
  const moveCompetenceToSection = (fromSectionIndex: number, competenceIndex: number, toSectionIndex: number) => {
    if (fromSectionIndex === toSectionIndex) return;
    
    const newSections = [...data.sections];
    const competence = {...newSections[fromSectionIndex].competences[competenceIndex]};
    
    // Supprimer de la section d'origine
    newSections[fromSectionIndex].competences.splice(competenceIndex, 1);
    
    // Réorganiser les ordres dans la section d'origine
    newSections[fromSectionIndex].competences.forEach((comp, idx) => {
      comp.ordre = idx + 1;
    });
    
    // Ajouter à la section de destination
    competence.ordre = newSections[toSectionIndex].competences.length + 1;
    newSections[toSectionIndex].competences.push(competence);
    
    setData('sections', newSections);
  };
  
  // Vérifier si le template est valide (minimum 5 compétences au total)
  const estValide = () => {
    const totalCompetences = data.sections.reduce(
      (total, section) => total + section.competences.length, 
      0
    );
    return totalCompetences >= 5;
  };
  
  // Soumettre le formulaire
  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    post('/admin/templates');
  };
  
  // Simuler un utilisateur administrateur pour la démo
  const mockUser = {
    name: 'Admin SABC',
    email: 'admin@sabc.cm',
    role: 'ADMIN',
    avatar: undefined
  };
  
  return (
    <AppLayout user={mockUser}>
      <Head title="Création de Template d'Évaluation | SABC Eval360" />
      
      <div className="container mx-auto py-6 max-w-7xl">
        <div className="flex justify-between items-center mb-6">
          <h1 className="text-2xl font-bold text-sabc-gray-900">Créer un Template d'Évaluation</h1>
        </div>
        
        <form onSubmit={handleSubmit}>
          {/* Informations générales */}
          <Card className="mb-6">
            <CardHeader>
              <CardTitle>Informations générales</CardTitle>
              <CardDescription>
                Définissez les caractéristiques principales du template
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div className="space-y-2">
                  <Label htmlFor="titre">Titre du template</Label>
                  <Input 
                    id="titre" 
                    value={data.titre}
                    onChange={e => setData('titre', e.target.value)}
                    placeholder="Ex: Évaluation Commerciale Standard"
                    required
                  />
                  {errors.titre && <p className="text-sabc-error text-sm">{errors.titre}</p>}
                </div>
                
                <div className="space-y-2">
                  <Label htmlFor="categorie">Catégorie</Label>
                  <Select 
                    value={data.categorie} 
                    onValueChange={value => setData('categorie', value)}
                  >
                    <SelectTrigger>
                      <SelectValue placeholder="Sélectionner une catégorie" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="commercial">Commercial</SelectItem>
                      <SelectItem value="marketing">Marketing</SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.categorie && <p className="text-sabc-error text-sm">{errors.categorie}</p>}
                </div>
              </div>
              
              <div className="space-y-2">
                <Label htmlFor="description">Description</Label>
                <Textarea 
                  id="description" 
                  value={data.description}
                  onChange={e => setData('description', e.target.value)}
                  placeholder="Description du template d'évaluation..."
                  rows={3}
                />
                {errors.description && <p className="text-sabc-error text-sm">{errors.description}</p>}
              </div>
              
              <div className="flex items-center space-x-2">
                <input 
                  type="checkbox" 
                  id="est_actif" 
                  checked={data.est_actif}
                  onChange={e => setData('est_actif', e.target.checked)}
                  className="h-4 w-4 text-sabc-red-primary focus:ring-sabc-red-light border-sabc-gray-200 rounded"
                />
                <Label htmlFor="est_actif">Activer ce template immédiatement</Label>
              </div>
            </CardContent>
          </Card>
          
          {/* Sections et compétences */}
          <Card className="mb-6">
            <CardHeader>
              <CardTitle>Sections et Compétences</CardTitle>
              <CardDescription>
                Organisez les compétences en sections thématiques
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Tabs 
                value={currentSection.toString()} 
                onValueChange={(value) => setCurrentSection(parseInt(value))}
              >
                <div className="flex justify-between items-center mb-4">
                  <TabsList className="flex-1 overflow-x-auto">
                    {data.sections.map((section, index) => (
                      <TabsTrigger 
                        key={section.id} 
                        value={index.toString()}
                        className="flex-shrink-0"
                      >
                        {section.titre || `Section ${index + 1}`}
                      </TabsTrigger>
                    ))}
                  </TabsList>
                  <Button 
                    type="button"
                    variant="outline" 
                    size="sm"
                    onClick={ajouterSection}
                    className="ml-2"
                  >
                    <PlusCircle className="h-4 w-4 mr-1" />
                    Ajouter une section
                  </Button>
                </div>
                
                {data.sections.map((section, sectionIndex) => (
                  <TabsContent key={section.id} value={sectionIndex.toString()}>
                    <div className="space-y-4">
                      {/* En-tête de section */}
                      <div className="flex justify-between items-center">
                        <div className="flex-1">
                          <div className="grid grid-cols-1 gap-3">
                            <div>
                              <Label htmlFor={`section-${sectionIndex}-titre`}>Titre de la section</Label>
                              <Input
                                id={`section-${sectionIndex}-titre`}
                                value={section.titre}
                                onChange={e => {
                                  const newSections = [...data.sections];
                                  newSections[sectionIndex].titre = e.target.value;
                                  setData('sections', newSections);
                                }}
                                placeholder="Titre de la section..."
                              />
                            </div>
                            <div>
                              <Label htmlFor={`section-${sectionIndex}-description`}>Description</Label>
                              <Textarea
                                id={`section-${sectionIndex}-description`}
                                value={section.description}
                                onChange={e => {
                                  const newSections = [...data.sections];
                                  newSections[sectionIndex].description = e.target.value;
                                  setData('sections', newSections);
                                }}
                                placeholder="Description courte de la section..."
                              />
                            </div>
                          </div>
                        </div>
                        
                        <Button 
                          type="button"
                          variant="ghost" 
                          size="sm" 
                          onClick={() => supprimerSection(sectionIndex)}
                          className="text-sabc-error ml-2"
                          disabled={data.sections.length <= 1}
                        >
                          <Trash2 className="h-4 w-4" />
                        </Button>
                      </div>
                      
                      {/* Liste des compétences */}
                      <div className="border rounded-md p-4">
                        <h3 className="font-semibold mb-4">Compétences de cette section</h3>
                        
                        <div className="space-y-2 min-h-[100px]">
                          {section.competences.map((competence, competenceIndex) => (
                            <div
                              key={competence.id}
                              className="flex items-center justify-between p-3 border rounded-md bg-white shadow-sm"
                            >
                              <div className="flex items-center mr-2 text-sabc-gray-400">
                                <GripVertical className="h-5 w-5" />
                              </div>
                              <div className="flex-1">
                                <div className="flex items-center">
                                  <span className="font-medium">{competence.libelle}</span>
                                  <Badge className="ml-2 bg-sabc-red-primary">
                                    Niveau {competence.niveau_requis}
                                  </Badge>
                                </div>
                                {competence.description && (
                                  <p className="text-sm text-sabc-gray-400 mt-1">{competence.description}</p>
                                )}
                              </div>
                              <div className="flex space-x-1">
                                {sectionIndex > 0 && (
                                  <Button
                                    type="button"
                                    variant="ghost"
                                    size="sm"
                                    onClick={() => moveCompetenceToSection(sectionIndex, competenceIndex, sectionIndex - 1)}
                                    title="Déplacer vers la section précédente"
                                  >
                                    <ArrowUp className="h-4 w-4" />
                                  </Button>
                                )}
                                {sectionIndex < data.sections.length - 1 && (
                                  <Button
                                    type="button"
                                    variant="ghost"
                                    size="sm"
                                    onClick={() => moveCompetenceToSection(sectionIndex, competenceIndex, sectionIndex + 1)}
                                    title="Déplacer vers la section suivante"
                                  >
                                    <ArrowDown className="h-4 w-4" />
                                  </Button>
                                )}
                                <Button
                                  type="button"
                                  variant="ghost"
                                  size="sm"
                                  onClick={() => supprimerCompetence(sectionIndex, competenceIndex)}
                                  className="text-sabc-error"
                                >
                                  <X className="h-4 w-4" />
                                </Button>
                              </div>
                                          <SelectItem key={s.id} value={idx.toString()}>
                                            {s.titre || `Section ${idx + 1}`}
                                          </SelectItem>
                                        );
                                      }
                                      return null;
                                    })}
                                  </SelectContent>
                                </Select>
                              )}
                              <Button 
                                type="button"
                                variant="ghost" 
                                size="sm"
                                className="text-sabc-error"
                                onClick={() => supprimerCompetence(sectionIndex, competenceIndex)}
                              >
                                <X className="h-4 w-4" />
                              </Button>
                            </div>
                          ))}
                          {section.competences.length === 0 && (
                            <div className="text-center py-8 text-sabc-gray-400">
                              Aucune compétence dans cette section.
                              <br />
                              Utilisez le formulaire ci-dessous pour en ajouter.
                            </div>
                          )}
                        </div>
                        
                        {/* Formulaire d'ajout de compétence */}
                        <div className="mt-4 border-t pt-4">
                          <h4 className="font-medium mb-2">Ajouter une compétence</h4>
                          <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                            <div className="md:col-span-2">
                              <Input 
                                value={newCompetence.libelle}
                                onChange={e => setNewCompetence({...newCompetence, libelle: e.target.value})}
                                placeholder="Libellé de la compétence"
                              />
                            </div>
                            <div>
                              <Select 
                                value={newCompetence.niveau_requis.toString()} 
                                onValueChange={value => setNewCompetence({...newCompetence, niveau_requis: parseInt(value)})}
                              >
                                <SelectTrigger>
                                  <SelectValue placeholder="Niveau requis" />
                                </SelectTrigger>
                                <SelectContent>
                                  <SelectItem value="1">Niveau 1</SelectItem>
                                  <SelectItem value="2">Niveau 2</SelectItem>
                                  <SelectItem value="3">Niveau 3</SelectItem>
                                  <SelectItem value="4">Niveau 4</SelectItem>
                                  <SelectItem value="5">Niveau 5</SelectItem>
                                </SelectContent>
                              </Select>
                            </div>
                          </div>
                          <div className="mt-2">
                            <Input 
                              value={newCompetence.description}
                              onChange={e => setNewCompetence({...newCompetence, description: e.target.value})}
                              placeholder="Description de la compétence (optionnel)"
                            />
                          </div>
                          <div className="mt-3 flex justify-end">
                            <Button 
                              type="button"
                              onClick={ajouterCompetence}
                              disabled={!newCompetence.libelle.trim()}
                            >
                              <Plus className="h-4 w-4 mr-1" />
                              Ajouter
                            </Button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </TabsContent>
                ))}
              </Tabs>
            </CardContent>
            <CardFooter className="flex justify-between border-t pt-4">
              <div>
                {!estValide() && (
                  <p className="text-sabc-error text-sm">
                    Le template doit contenir au moins 5 compétences au total.
                  </p>
                )}
              </div>
              <div className="flex space-x-2">
                <Button 
                  type="button" 
                  variant="outline"
                  onClick={() => window.history.back()}
                >
                  Annuler
                </Button>
                <Button 
                  type="submit" 
                  disabled={processing || !estValide()}
                  className="bg-sabc-red-primary hover:bg-sabc-red-dark text-white"
                >
                  Créer le template
                </Button>
              </div>
            </CardFooter>
          </Card>
        </form>
      </div>
    </AppLayout>
  );
};

export default CreateTemplateAdminPage;
