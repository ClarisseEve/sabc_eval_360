<?xml version="1.0"?>
<!-- =============================================================================
     SABC Eval360 - ClickHouse Users Configuration
     ============================================================================= -->
<clickhouse>
    <profiles>
        <!-- Default profile (dev: limites réduites) -->
        <default>
            <max_memory_usage>536870912</max_memory_usage>  <!-- 512 MB -->
            <max_execution_time>300</max_execution_time>
            <max_rows_to_read>100000000</max_rows_to_read>
            <max_bytes_to_read>10000000000</max_bytes_to_read>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </default>

        <!-- Profile for heavy analytics (dev: 1 GB) -->
        <analytics>
            <max_memory_usage>1073741824</max_memory_usage>  <!-- 1 GB -->
            <max_execution_time>600</max_execution_time>
            <max_rows_to_read>1000000000</max_rows_to_read>
            <max_bytes_to_read>100000000000</max_bytes_to_read>
            <use_uncompressed_cache>1</use_uncompressed_cache>
        </analytics>

        <!-- Profile for data ingestion -->
        <ingestion>
            <max_memory_usage>536870912</max_memory_usage>  <!-- 512 MB -->
            <max_execution_time>3600</max_execution_time>
            <max_insert_block_size>1048576</max_insert_block_size>
        </ingestion>

        <!-- Read-only profile for dashboards -->
        <readonly>
            <readonly>1</readonly>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_execution_time>60</max_execution_time>
        </readonly>
    </profiles>

    <users>
        <!-- Default user (admin) -->
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>

        <!-- Application user for Laravel (dev: mot de passe vide) -->
        <!-- Pour prod: générer SHA256 avec: echo -n 'password' | sha256sum -->
        <sabc_app>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </sabc_app>

        <!-- Analytics user (dev: mot de passe vide) -->
        <sabc_analytics>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>analytics</profile>
            <quota>default</quota>
        </sabc_analytics>

        <!-- Grafana read-only user (dev: mot de passe vide) -->
        <grafana>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
        </grafana>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
