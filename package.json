{
    "private": true,
    "type": "module",
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile && pnpm --dir apps/api install --frozen-lockfile && pnpm --dir apps/web install --frozen-lockfile",
    "dev": "concurrently -n api,web -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "pnpm --dir apps/web build",
    "build:api": "pnpm --dir apps/api build",
    "preview": "pnpm --dir apps/web preview",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "typecheck:api": "pnpm --dir apps/api typecheck",
    "seed:api": "pnpm --dir apps/api db:seed",
    "test:api": "pnpm --dir apps/api test:ci",
    "test:web": "pnpm --dir apps/web test:ci",
    "test": "pnpm test:web && pnpm test:api",
    "test:e2e:api": "pnpm --dir apps/api test:e2e",
    "test:e2e:web": "pnpm --dir apps/api test:e2e:prepare && playwright test",
    "test:e2e:web:headed": "pnpm --dir apps/api test:e2e:prepare && playwright test --headed",
    "test:e2e:web:install": "playwright install --only-shell chromium",
    "audit:prod": "pnpm --dir apps/api audit:prod && pnpm --dir apps/web audit:prod",
    "verify:static": "pnpm typecheck && pnpm --dir apps/api exec prisma validate && pnpm build && pnpm test",
    "verify:compose": "docker compose --env-file .env.example config --quiet && docker compose --env-file .env.example -f docker-compose.scale.yml config --quiet",
    "format": "pnpm --dir apps/api format",
    "lint": "pnpm --dir apps/api lint:check"
  },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@playwright/test": "^1.54.2",
        "@types/node": "^22.13.5",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.23.0"
    },
    "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
