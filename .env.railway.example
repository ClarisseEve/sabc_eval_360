# Variables du service API sur Railway (onglet "Variables" > "Raw Editor").
# Les ${{...}} sont des references Railway: MySQL, Postgres et Redis doivent
# correspondre exactement aux noms des services de base de donnees du projet.
# Ne jamais versionner les valeurs reelles.

# Railway route le domaine public vers ce port: le "Port cible" du domaine
# (Settings > Networking) doit avoir la meme valeur.
PORT=8080
NODE_ENV=production
# Origines autorisees par CORS (frontend Vercel), separees par des virgules, sans / final.
FRONTEND_URL=https://sabc-eval-360-j8f5.vercel.app

JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# MySQL: choisir UNE des deux options.
# a) Service MySQL Railway (template ou image Docker mysql:8.0):
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# b) MariaDB embarque dans le conteneur API (DATABASE_URL derivee au demarrage).
#    Exige un volume Railway monte sur /data pour ce service, sinon les donnees
#    sont perdues a chaque deploiement.
WITH_MARIADB=true
EMBEDDED_MYSQL=true
EMBEDDED_MYSQL_PASSWORD=CHANGE_ME_LETTRES_CHIFFRES_UNIQUEMENT
EMBEDDED_MYSQL_DATADIR=/data/mysql
EMBEDDED_MYSQL_BUFFER_POOL=128M

PG_HOST=${{Postgres.PGHOST}}
PG_PORT=${{Postgres.PGPORT}}
PG_DATABASE=${{Postgres.PGDATABASE}}
PG_USER=${{Postgres.PGUSER}}
PG_PASSWORD=${{Postgres.PGPASSWORD}}

CACHE_DRIVER=redis
REDIS_URL=${{Redis.REDIS_URL}}
CACHE_PREFIX=sabc_eval360
# Une seule replique: les taches planifiees ne sont pas protegees contre
# l'execution concurrente.
SCHEDULER_ENABLED=true

# SMTP facultatif (envoi des fiches de notation PDF).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

RUN_MIGRATIONS=true
# Premier deploiement de demonstration uniquement: RUN_SEED=true,
# ALLOW_DEMO_SEED=true et SEED_PASSWORD fort, puis repasser RUN_SEED=false.
RUN_SEED=false
SEED_MODE=if-empty
ALLOW_DEMO_SEED=false
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# ----------------------------------------------------------------------------
# Vercel (Settings > Environment Variables, Production + Preview), pas Railway:
# VITE_API_URL=https://apisabceval360-production.up.railway.app/api
# Variable figee au build: redeployer le site Vercel sans cache apres modification.
# ----------------------------------------------------------------------------
