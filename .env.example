APP_NAME="SABC Eval360"
# Copier vers .env puis remplacer chaque CHANGE_ME. Aucune valeur reelle ne doit
# etre committee, meme en developpement.
NODE_ENV=development

# Frontend / API
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api
PORT=3000
WEB_PORT=5173
API_PORT=3000
# Activer les crons sur une seule instance API quand plusieurs replicas tournent.
SCHEDULER_ENABLED=true

# Auth
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=7d

# MySQL core
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
DATABASE_URL="mysql://sabc_user:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/sabc_core"
# DSN utilisé à l'intérieur du réseau Compose (encoder les caractères spéciaux).
DATABASE_URL_DOCKER="mysql://sabc_user:CHANGE_ME_MYSQL_PASSWORD@mysql:3306/sabc_core"
MYSQL_PORT=3306

# PostgreSQL business
PG_HOST=localhost
PG_PORT=5432
PG_PORT_HOST=5432
PG_DATABASE=sabc_business
PG_USER=sabc_user
PG_PASSWORD=CHANGE_ME_PG_PASSWORD
# Autorisation ponctuelle, uniquement pour baseliner un schéma PostgreSQL
# existant dont la structure correspond exactement aux migrations.
PG_BASELINE_EXISTING=false

# Cache
CACHE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
REDIS_URL_DOCKER=redis://redis:6379
CACHE_PREFIX=sabc_eval360
REDIS_PORT=6379

# Initialisation automatique des conteneurs
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_MODE=if-empty
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD
ALLOW_DEMO_SEED=false
