# =============================================================================
# SABC Eval360 - Environment Configuration
# =============================================================================
# For Docker deployment, see .env.docker
# Copy this file to .env and configure for your environment

APP_NAME="SABC Eval360"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# MySQL (CORE Database) - for local dev use SQLite, for Docker use mysql
# =============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sabc_core
# DB_USERNAME=sabc_user
# DB_PASSWORD=

# =============================================================================
# PostgreSQL (BUSINESS Database) - required for evaluations
# =============================================================================
# DB_PGSQL_HOST=127.0.0.1
# DB_PGSQL_PORT=5432
# DB_PGSQL_DATABASE=sabc_business
# DB_PGSQL_USERNAME=sabc_user
# DB_PGSQL_PASSWORD=

# =============================================================================
# ClickHouse (ANALYTICS Database) - optional for analytics
# =============================================================================
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=sabc_analytics
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sabc.cm"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Microservices (Strangler Pattern)
# Set to true when migrating to microservices architecture
# =============================================================================
EVALUATION_MICROSERVICE_ENABLED=false
EVALUATION_SERVICE_URL=http://evaluation-service:8080
EVALUATION_SERVICE_GRPC=evaluation-service:50051
EVALUATION_SERVICE_KEY=internal-service-key
EVALUATION_SERVICE_TIMEOUT=30

ANALYTICS_MICROSERVICE_ENABLED=false
ANALYTICS_SERVICE_URL=http://analytics-service:8080
ANALYTICS_SERVICE_KEY=internal-service-key
ANALYTICS_SERVICE_TIMEOUT=60

# JWT Secret for microservice authentication
JWT_SECRET=

# =============================================================================
# Observability - Tracing (Jaeger)
# =============================================================================
JAEGER_ENABLED=false
JAEGER_SERVICE_NAME=core-app
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
JAEGER_LOG_SPANS=false

# =============================================================================
# Grafana (Docker only)
# =============================================================================
GRAFANA_PASSWORD=admin

# =============================================================================
# Alertmanager (Docker only - optional)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
