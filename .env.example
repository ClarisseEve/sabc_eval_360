# Configuration locale Docker Compose. Remplacer tous les CHANGE_ME avant usage.
# Les mots de passe integres aux URL doivent etre encodes en URL si necessaire.

NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
VITE_API_URL=/api
FRONTEND_URL=http://localhost:5173

JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
DATABASE_URL=mysql://sabc_user:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/sabc_core
DATABASE_URL_DOCKER=mysql://sabc_user:CHANGE_ME_MYSQL_PASSWORD@mysql:3306/sabc_core
MYSQL_PORT=3306

PG_DATABASE=sabc_business
PG_USER=sabc_user
PG_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
PG_PORT_HOST=5432

CACHE_DRIVER=redis
REDIS_URL_DOCKER=redis://redis:6379
REDIS_PORT=6379
CACHE_PREFIX=sabc_eval360
SCHEDULER_ENABLED=true

# Seed de demonstration pour la premiere installation locale uniquement.
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_MODE=if-empty
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD
ALLOW_DEMO_SEED=true
