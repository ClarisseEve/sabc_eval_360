APP_NAME="SABC Eval360"
NODE_ENV=development

# Frontend / API
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
PORT=3000

# Auth
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# MySQL core
MYSQL_ROOT_PASSWORD=***REMOVED***
MYSQL_PASSWORD=secret
DATABASE_URL="mysql://sabc_user:secret@localhost:3306/sabc_core"

# PostgreSQL business
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sabc_business
PG_USER=sabc_user
PG_PASSWORD=secret

# Cache
CACHE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
CACHE_PREFIX=sabc_eval360

# Seed
SEED_PASSWORD=***REMOVED***
